# copie estes nomes para as variaveis privadas do projeto na vercel
# gere um segredo novo para cada ambiente com: openssl rand -hex 32
SESSION_SECRET=

# use env com usuarios na vercel ou firebase com usuarios no firestore
AUTH_STORE=env

# modo sqlite (ex.: container com volume em /data): AUTH_STORE=sqlite e DB_PATH=/data/users.db
# a tabela users e criada automaticamente, mas sem nenhum usuario; o operador deve inserir
# usuarios com senha em hash (scrypt salt:hash) e segredo TOTP proprio
DB_PATH=

# preencha somente no modo env, o formato esta no readme
AUTH_USERS_JSON=

# preencha somente no modo firebase, o json da conta de servico fica em uma linha
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# o limite de tentativas de login precisa de redis compartilhado em producao
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# filtro extra de contas, separado por virgulas, se voce precisar
ALLOWED_USERS=

# logging do Next.js: LOG_LEVEL = debug|info|warn|error (padrao: info em producao, debug em dev)
# LOG_FORMAT = json|pretty (padrao: json em producao, pretty em dev)
LOG_LEVEL=
LOG_FORMAT=

# logging do servico Rust: RUST_LOG segue a sintaxe do tracing (ex.: info, crypto_server=debug)
# RUST_LOG_FORMAT=json emite uma linha JSON por evento (padrao: compacto)
# RUST_LOG=info
# RUST_LOG_FORMAT=json
