# copie estes nomes para as variaveis privadas do projeto na vercel
# gere um segredo novo para cada ambiente com: openssl rand -hex 32
SESSION_SECRET=

# use env com usuarios na vercel ou firebase com usuarios no firestore
AUTH_STORE=env

# preencha somente no modo env, o formato esta no readme
AUTH_USERS_JSON=

# preencha somente no modo firebase, o json da conta de servico fica em uma linha
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=

# o limite de tentativas de login precisa de redis compartilhado em producao
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# filtro extra de contas, separado por virgulas, se voce precisar
ALLOWED_USERS=
